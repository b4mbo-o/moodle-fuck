{
  "manifest_version": 3,
  "name": "MoodleFuck",
  "version": "1.0",
  "description": "Moodle quiz helper using OpenAI, OpenRouter, Gemini, and CAPI APIs.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://capi.voids.top/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MoodleFuck Settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [ "http://*/mod/quiz/attempt.php*", "https://*/mod/quiz/attempt.php*" ],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
